# 1. Ignore everything at the root
/*

# 2. Allow the directories themselves (required for Git to look inside)
!/hsr_mm_control/
!/hsr_vision/

# 3. Allow the .gitignore itself
!/.gitignore

# 4. Global safety for Python junk (regardless of allow-list)
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
