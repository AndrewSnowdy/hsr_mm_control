<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <ode><solver><type>quick</type><iters>50</iters></solver></ode>
    </physics>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Walls flanking the double doors -->
    <model name="hallway_wall_left">
      <static>true</static>
      <pose>3.0 -2.35 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 2.6 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 2.6 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="hallway_wall_right">
      <static>true</static>
      <pose>3.0 2.3 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 2.5 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 2.5 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Right door leaf: hinge at Y=-1.005, opens in -rotation (outward) -->
    <model name="handicap_door_right">
      <pose>3.0 -1.005 1.0 0 0 1.5708</pose>

      <link name="door_frame">
        <visual name="v"><geometry><box><size>0.06 0.06 2.0</size></box></geometry></visual>
      </link>

      <link name="door_leaf">
        <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="leaf_col"><pose>0.5 0 0 0 0 0</pose><geometry><box><size>1.0 0.05 2.0</size></box></geometry></collision>
        <visual name="leaf_vis"><pose>0.5 0 0 0 0 0</pose><geometry><box><size>1.0 0.05 2.0</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>

      <joint name="door_hinge" type="revolute">
        <parent>door_frame</parent>
        <child>door_leaf</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.57</lower>
            <upper>0</upper>
            <velocity>0.6</velocity>
            <effort>20</effort>
          </limit>
          <dynamics><damping>5.0</damping><friction>0.1</friction></dynamics>
        </axis>
      </joint>

      <joint name="world_fix" type="fixed"><parent>world</parent><child>door_frame</child></joint>

      <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
      <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
        <joint_name>door_hinge</joint_name>
        <topic>/model/handicap_door_right/door_cmd</topic>
        <p_gain>100</p_gain>
        <i_gain>1</i_gain>
        <d_gain>10</d_gain>
      </plugin>
    </model>

    <!-- Left door leaf: hinge at Y=1.005, opens in +rotation (outward) -->
    <model name="handicap_left_left">
      <pose>3.0 1.005 1.0 0 0 1.5708</pose>

      <link name="door_frame">
        <visual name="v"><geometry><box><size>0.06 0.06 2.0</size></box></geometry></visual>
      </link>

      <link name="door_leaf">
        <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="leaf_col"><pose>-0.5 0 0 0 0 0</pose><geometry><box><size>1.0 0.05 2.0</size></box></geometry></collision>
        <visual name="leaf_vis"><pose>-0.5 0 0 0 0 0</pose><geometry><box><size>1.0 0.05 2.0</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>

      <joint name="door_hinge" type="revolute">
        <parent>door_frame</parent>
        <child>door_leaf</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>0.0</lower>
            <upper>1.57</upper>
            <velocity>0.6</velocity>
            <effort>20</effort>
          </limit>
          <dynamics><damping>5.0</damping><friction>0.1</friction></dynamics>
        </axis>
      </joint>

      <joint name="world_fix" type="fixed"><parent>world</parent><child>door_frame</child></joint>

      <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
      <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
        <joint_name>door_hinge</joint_name>
        <topic>/model/handicap_door_left/door_cmd</topic>
        <p_gain>100</p_gain>
        <i_gain>1</i_gain>
        <d_gain>10</d_gain>
      </plugin>
    </model>

    <!-- ADA button (X-facing, press axis = X) -->
    <model name="ada_button">
      <static>true</static>
      <pose>2.94 -1.35 1.0 0 0 0</pose>

      <link name="button_link">
        <visual name="v">
          <geometry><box><size>0.02 0.15 0.15</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>

        <collision name="button_collision">
          <pose>0.03 0 0 0 0 0</pose>
          <geometry><box><size>0.08 0.20 0.20</size></box></geometry>
          <surface>
            <contact>
              <collide_without_contact>true</collide_without_contact>
            </contact>
          </surface>
          <category_bitmask>0x02</category_bitmask>
        </collision>

        <sensor name="button_contact_sensor" type="contact">
          <contact>
            <collision>button_collision</collision>
          </contact>
          <update_rate>100</update_rate>
        </sensor>
      </link>

      <plugin filename="ignition-gazebo-touchplugin-system"
              name="ignition::gazebo::systems::TouchPlugin">
        <target>hsrb</target>
        <namespace>button_logic</namespace>
        <time>0.001</time>
        <enabled>true</enabled>
      </plugin>
    </model>

    <!-- ADA button (X-facing, press axis = -X, back side of door wall) -->
    <model name="ada_button_back">
      <static>true</static>
      <pose>3.06 1.35 1.0 0 0 0</pose>

      <link name="button_link">
        <visual name="v">
          <geometry><box><size>0.02 0.15 0.15</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>

        <collision name="button_collision">
          <pose>-0.03 0 0 0 0 0</pose>
          <geometry><box><size>0.08 0.20 0.20</size></box></geometry>
          <surface>
            <contact>
              <collide_without_contact>true</collide_without_contact>
            </contact>
          </surface>
          <category_bitmask>0x02</category_bitmask>
        </collision>

        <sensor name="button_contact_sensor" type="contact">
          <contact>
            <collision>button_collision</collision>
          </contact>
          <update_rate>100</update_rate>
        </sensor>
      </link>

      <plugin filename="ignition-gazebo-touchplugin-system"
              name="ignition::gazebo::systems::TouchPlugin">
        <target>hsrb</target>
        <namespace>button_back_logic</namespace>
        <time>0.001</time>
        <enabled>true</enabled>
      </plugin>
    </model>

    <!-- ===== Simulated Person (Gazebo Actor) ===== -->
    <actor name="sim_person">
      <!-- <pose>0 0 0.0 0 0 0</pose>  -->
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>0.2</scale>
      </skin>

      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>

      <script>
        <loop>true</loop>
        <auto_start>false</auto_start>
        
        <trajectory id="0" type="walk">
          <waypoint>
            <time>0.0</time>
            <pose>6 0 1.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>25.0</time>
            <pose>6 0 1.0 0 0 3.14159</pose>
          </waypoint>

          <waypoint>
            <time>32.0</time>
            <pose>0.0 0 1.0 0 0 3.14159</pose>
          </waypoint>

          <waypoint>
            <time>41.0</time>
            <pose>0 0 1.0 0 0 3.14159</pose> </waypoint>
        </trajectory>
      </script>



    </actor>

  </world>
</sdf>