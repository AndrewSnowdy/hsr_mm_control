<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>

    <physics type="ode">
      <real_time_update_rate>333.0</real_time_update_rate>
      <max_step_size>0.003</max_step_size>
      <ode><solver><type>quick</type><iters>100</iters></solver></ode>
    </physics>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Front barrier walls -->
    <model name="hallway_wall_left">
      <static>true</static>
      <pose>3.0 -2.35 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 2.6 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 2.6 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="hallway_wall_right">
      <static>true</static>
      <pose>3.0 2.3 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 2.5 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 2.5 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- room_wall_left: shortened from 6.0m to 5.0m, recentered at x=0.5
        now spans x=-2.0..3.0, matching back wall at x=-2.0 and door wall at x=3.0 -->
    <model name="room_wall_left">
      <static>true</static>
      <pose>0.5 -3.65 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>5.0 0.1 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>5.0 0.1 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- room_wall_right: shortened from 6.0m to 5.0m, recentered at x=0.5
        now spans x=-2.0..3.0, matching back wall at x=-2.0 and door wall at x=3.0 -->
    <model name="room_wall_right">
      <static>true</static>
      <pose>0.5 3.55 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>5.0 0.1 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>5.0 0.1 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Back wall moved from x=-3.0 to x=-2.0 -->
    <model name="room_wall_back">
      <static>true</static>
      <pose>-2.0 -0.05 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 7.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 7.2 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Hallway end wall x=10.0 -->
    <model name="hallway_end_wall">
      <static>true</static>
      <pose>10.0 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 3.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 3.0 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- North wall: x=3.0..10.0 → length=7.0 m, centered at x=6.5 -->
    <model name="hallway_ext_wall_right">
      <static>true</static>
      <pose>6.5 1.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>7.0 0.1 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>7.0 0.1 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>


    <!-- ============================================================
        SIDE ROOM
        Spans x=5.0..9.0 (4 m), y=-1.5..-5.5 (4 m deep into -Y)
        The y=-1.5 face is the hallway wall (already covered above).
        ============================================================ -->

    <!-- Side room back wall: now spans x=3.0..10.0 → length=7.0 m, centered at x=6.5 -->
    <model name="side_room_wall_back">
      <static>true</static>
      <pose>6.5 -5.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>7.0 0.1 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>7.0 0.1 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Side room left wall: x=3.0, spans y=-1.5..-5.5 → length=4.0 m, centered at y=-3.5 -->
    <model name="side_room_wall_left">
      <static>true</static>
      <pose>3.0 -3.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 4.0 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Side room right wall: x=10.0, spans y=-1.5..-5.5 → length=4.0 m, centered at y=-3.5 -->
    <model name="side_room_wall_right">
      <static>true</static>
      <pose>10.0 -3.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 4.0 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
        SIDE ROOM DOOR + BUTTON
        Single leaf, hinge at x=6.5 y=-1.5, leaf spans +X toward x=7.5
        Opens into room (-Y rotation, lower limit -1.57)
        ============================================================ -->
    <!-- South wall segment A: x=3.0..7.0 → length=4.0 m, centered at x=5.0 -->
    <model name="hallway_ext_wall_left_A">
      <static>true</static>
      <pose>5.0 -1.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.0 0.1 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.0 0.1 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall segment B: x=8.0..10.0 → length=2.0 m, centered at x=9.0 -->
    <model name="hallway_ext_wall_left_B">
      <static>true</static>
      <pose>9.0 -1.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.1 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.0 0.1 2.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Door hinge at x=7.95, leaf spans -X by 0.9 m to x=7.05 — clears wall A at x=7.0 -->
    <model name="side_room_door">
      <pose>7.95 -1.5 1.0 0 0 0</pose>
      <link name="door_frame">
        <visual name="v"><geometry><box><size>0.06 0.06 2.0</size></box></geometry></visual>
      </link>
      <link name="door_leaf">
        <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="leaf_col"><pose>-0.45 0 0 0 0 0</pose><geometry><box><size>0.9 0.05 2.0</size></box></geometry></collision>
        <visual name="leaf_vis"><pose>-0.45 0 0 0 0 0</pose><geometry><box><size>0.9 0.05 2.0</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
      <joint name="door_hinge" type="revolute">
        <parent>door_frame</parent>
        <child>door_leaf</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>0</lower>
            <upper>1.57</upper>
            <velocity>0.6</velocity>
            <effort>20</effort>
          </limit>
          <dynamics><damping>5.0</damping><friction>0.1</friction></dynamics>
        </axis>
      </joint>
      <joint name="world_fix" type="fixed"><parent>world</parent><child>door_frame</child></joint>
      <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
      <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
        <joint_name>door_hinge</joint_name>
        <topic>/model/side_room_door/door_cmd</topic>
        <p_gain>100</p_gain>
        <i_gain>1</i_gain>
        <d_gain>10</d_gain>
      </plugin>
    </model>

    <!-- ADA button: moved left to x=6.75, sitting on wall A just before the gap -->
    <model name="ada_button_side">
      <static>true</static>
      <pose>6.75 -1.44 1.0 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.15 0.02 0.15</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
        <collision name="button_collision"><geometry><box><size>0.15 0.02 0.15</size></box></geometry></collision>
        <sensor name="button_contact_sensor" type="contact"><contact><collision>button_collision</collision></contact></sensor>
      </link>
      <plugin filename="ignition-gazebo-touchplugin-system" name="ignition::gazebo::systems::TouchPlugin">
        <target>hsrb</target>
        <namespace>button_side_logic</namespace>
        <time>0.01</time>
        <enabled>true</enabled>
      </plugin>
    </model>

    <!-- ADA button — inside the side room, to the left of the door (closer to origin)
        Flush with the room face of the south hallway wall (inner face at y=-1.45)
        x=6.75 places it just left of the door gap (gap starts at x=7.0) -->
    <model name="ada_button_side_interior">
      <static>true</static>
      <pose>6.75 -1.56 1.0 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.15 0.02 0.15</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
        <collision name="button_collision"><geometry><box><size>0.15 0.02 0.15</size></box></geometry></collision>
        <sensor name="button_contact_sensor" type="contact"><contact><collision>button_collision</collision></contact></sensor>
      </link>

      <plugin filename="ignition-gazebo-touchplugin-system" name="ignition::gazebo::systems::TouchPlugin">
        <target>hsrb</target>
        <namespace>button_side_interior_logic</namespace>
        <time>0.01</time>
        <enabled>true</enabled>
      </plugin>
    </model>


    <!-- ============================================================
        MAIN ROOM DOUBLE DOORS
        AND BUTTONS
        ============================================================ -->
    <!-- Right door leaf: hinge at Y=-1.005, leaf spans toward Y=0.0, opens in -rotation (outward) -->
    <model name="handicap_door_right">
      <pose>3.0 -1.005 1.0 0 0 1.5708</pose>

      <link name="door_frame">
        <visual name="v"><geometry><box><size>0.06 0.06 2.0</size></box></geometry></visual>
      </link>

      <link name="door_leaf">
        <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="leaf_col"><pose>0.5 0 0 0 0 0</pose><geometry><box><size>1.0 0.05 2.0</size></box></geometry></collision>
        <visual name="leaf_vis"><pose>0.5 0 0 0 0 0</pose><geometry><box><size>1.0 0.05 2.0</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>

      <joint name="door_hinge" type="revolute">
        <parent>door_frame</parent>
        <child>door_leaf</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-1.57</lower>
            <upper>0</upper>
            <velocity>0.6</velocity>
            <effort>20</effort>
          </limit>
          <dynamics><damping>5.0</damping><friction>0.1</friction></dynamics>
        </axis>
      </joint>

      <joint name="world_fix" type="fixed"><parent>world</parent><child>door_frame</child></joint>

      <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
      <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
        <joint_name>door_hinge</joint_name>
        <topic>/model/handicap_door_right/door_cmd</topic>
        <p_gain>100</p_gain>
        <i_gain>1</i_gain>
        <d_gain>10</d_gain>
      </plugin>
    </model>

    <!-- left door leaf: hinge at Y=1.005, leaf spans toward Y=0.0, opens in +rotation (outward) -->
    <model name="handicap_left_left">
      <pose>3.0 1.005 1.0 0 0 1.5708</pose>

      <link name="door_frame">
        <visual name="v"><geometry><box><size>0.06 0.06 2.0</size></box></geometry></visual>
      </link>

      <link name="door_leaf">
        <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="leaf_col"><pose>-0.5 0 0 0 0 0</pose><geometry><box><size>1.0 0.05 2.0</size></box></geometry></collision>
        <visual name="leaf_vis"><pose>-0.5 0 0 0 0 0</pose><geometry><box><size>1.0 0.05 2.0</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>

      <joint name="door_hinge" type="revolute">
        <parent>door_frame</parent>
        <child>door_leaf</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>0.0</lower>
            <upper>1.57</upper>
            <velocity>0.6</velocity>
            <effort>20</effort>
          </limit>
          <dynamics><damping>5.0</damping><friction>0.1</friction></dynamics>
        </axis>
      </joint>

      <joint name="world_fix" type="fixed"><parent>world</parent><child>door_frame</child></joint>

      <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
      <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
        <joint_name>door_hinge</joint_name>
        <topic>/model/handicap_door_left/door_cmd</topic>
        <p_gain>100</p_gain>
        <i_gain>1</i_gain>
        <d_gain>10</d_gain>
      </plugin>
    </model>

    <!-- Button: flush with wall, to the right (negative Y) of the doors -->
    <model name="ada_button">
      <static>true</static>
      <pose>2.94 -1.35 1.0 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.02 0.15 0.15</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
        <collision name="button_collision"><geometry><box><size>0.02 0.15 0.15</size></box></geometry></collision>
        <sensor name="button_contact_sensor" type="contact"><contact><collision>button_collision</collision></contact></sensor>
      </link>

      <plugin filename="ignition-gazebo-touchplugin-system" name="ignition::gazebo::systems::TouchPlugin">
        <target>hsrb</target>
        <namespace>button_logic</namespace>
        <time>0.01</time>
        <enabled>true</enabled>
      </plugin>
    </model>

    <!-- ADA button — hallway side of double door
        Flush with the inner face of hallway_ext_wall_right (inner face at y=1.45)
        Positioned at x=3.2, facing into the hallway (-Y) -->
    <model name="ada_button_hallway">
      <static>true</static>
      <pose>4.2 1.44 1.0 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.15 0.02 0.15</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material>
        </visual>
        <collision name="button_collision"><geometry><box><size>0.15 0.02 0.15</size></box></geometry></collision>
        <sensor name="button_contact_sensor" type="contact"><contact><collision>button_collision</collision></contact></sensor>
      </link>

      <plugin filename="ignition-gazebo-touchplugin-system" name="ignition::gazebo::systems::TouchPlugin">
        <target>hsrb</target>
        <namespace>button_hallway_logic</namespace>
        <time>0.01</time>
        <enabled>true</enabled>
      </plugin>
    </model>


    <!-- ============================================================
        MAIN ROOM TABLES
        Back wall at x=-3.0, tables placed 1.0m away at x=-2.2
        Centered around y=0, spaced 0.2m apart
        Table footprint 1.6x0.8m (length along Y, depth along X)
        Table 1: y=-0.9, Table 2: y=0.9
        ============================================================ -->

    <!-- Table 1 moved from x=-2.2 to x=-1.2 -->
    <model name="main_room_table_1">
      <static>true</static>
      <pose>-1.2 -0.9 0.375 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 1.6 0.75</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.8 1.6 0.75</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Table 2 moved from x=-2.2 to x=-1.2 -->
    <model name="main_room_table_2">
      <static>true</static>
      <pose>-1.2 0.9 0.375 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 1.6 0.75</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.8 1.6 0.75</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
        SIDE ROOM TABLES
        Back wall at y=-5.5, tables placed 1.0m away at y=-4.7
        Centered around x=6.5, spaced 0.2m apart
        Table footprint 1.6x0.8m (length along X, depth along Y)
        Table 1: x=5.7, Table 2: x=7.3
        ============================================================ -->

    <!-- Side room table 1: moved from x=5.7 to x=5.3 for more spacing -->
    <model name="side_room_table_1">
      <static>true</static>
      <pose>5.3 -4.7 0.375 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.6 0.8 0.75</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.6 0.8 0.75</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Side room table 2: moved from x=7.3 to x=7.7 for more spacing -->
    <model name="side_room_table_2">
      <static>true</static>
      <pose>7.7 -4.7 0.375 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.6 0.8 0.75</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.6 0.8 0.75</size></box></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Coke can sitting on side_room_table_1
        Table top surface is at z = 0.375 + 0.375 = 0.75m
        Can: radius=0.033m, length=0.122m, so center at z=0.75+0.061=0.811 -->
    <model name="coke_can">
      <static>false</static>
      <pose>5.3 -4.35 0.811 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.39</mass>
          <inertia>
            <ixx>0.00055</ixx><iyy>0.00055</iyy><izz>0.00018</izz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.033</radius><length>0.122</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.033</radius><length>0.122</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.0 0.0 1</ambient>
            <diffuse>0.8 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


  </world>
</sdf>